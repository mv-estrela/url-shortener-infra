worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 4096;
}

http {
    access_log /var/log/nginx/access.log;

    upstream app {
{% for host in groups['app'] %}
        server {{ hostvars[host].ansible_host }}:{{ app_port }} max_fails=3 fail_timeout=10s;
{% endfor %}
        keepalive 64;
    }

    server {
        listen 80;

        # Lightweight health/liveness for the proxy itself.
        location = /nginx-health {
            access_log off;
            return 200 "ok\n";
        }

        location / {
            proxy_pass http://app;
            proxy_http_version 1.1;
            proxy_set_header Connection        "";

            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # If an instance is down or mid-restart, try the other one.
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_connect_timeout 2s;
        }
    }

    # Scraped by nginx-exporter over loopback only.
    server {
        listen 127.0.0.1:{{ nginx_status_port }};

        location = /nginx_status {
            stub_status;
            access_log off;
        }
    }
}
