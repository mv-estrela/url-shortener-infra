services:
  redis:
    image: {{ redis_image }}
    network_mode: host
    restart: unless-stopped
    command:
      - redis-server
      - --bind
      - 0.0.0.0
      - --port
      - "{{ redis_port }}"
      - --protected-mode
      - "no"
      - --save
      - ""
      - --appendonly
      - "no"
      - --maxmemory
      - {{ redis_maxmemory }}
      - --maxmemory-policy
      - allkeys-lru
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "{{ redis_port }}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis-exporter:
    image: {{ redis_exporter_image }}
    network_mode: host
    restart: unless-stopped
    environment:
      REDIS_ADDR: redis://127.0.0.1:{{ redis_port }}
      REDIS_EXPORTER_WEB_LISTEN_ADDRESS: ":{{ redis_exporter_port }}"
    depends_on:
      redis:
        condition: service_healthy
